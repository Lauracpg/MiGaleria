<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PING a google.com"
        android:textColor="@android:color/black"
        android:textSize="21sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Introduce el número de intentos"
        android:textColor="#666666"
        android:textSize="13sp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp" />

    <EditText
        android:id="@+id/numeroIntentos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Número de intentos"
        android:inputType="number"
        android:gravity="center"
        android:textSize="16sp"
        android:layout_marginTop="14dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonIniciarPing"
        android:layout_width="200dp"
        android:layout_height="46dp"
        android:text="Iniciar"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:backgroundTint="@android:color/black"
        android:padding="0dp"
        android:layout_gravity="center"
        android:layout_marginTop="18dp"
        app:icon="@drawable/ic_play"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@android:color/white"
        app:cornerRadius="18dp"
        app:strokeWidth="0dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonPararPing"
        android:layout_width="200dp"
        android:layout_height="46dp"
        android:text="Parar"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:backgroundTint="@android:color/black"
        android:padding="0dp"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        app:icon="@drawable/ic_stop"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@android:color/white"
        app:cornerRadius="18dp"
        app:strokeWidth="0dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonCerrarPing"
        android:layout_width="200dp"
        android:layout_height="46dp"
        android:text="Cerrar"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:backgroundTint="@android:color/black"
        android:padding="0dp"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        app:icon="@drawable/ic_close"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@android:color/white"
        app:cornerRadius="18dp"
        app:strokeWidth="0dp" />

    <TextView
        android:id="@+id/textoResultadoPing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@android:color/black"
        android:textSize="14sp"
        android:layout_marginTop="20dp" />

</LinearLayout>